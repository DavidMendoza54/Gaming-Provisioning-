APP_ENV=local
APP_BASE_DOMAIN=apps.localhost
APP_PUBLIC_SCHEME=http
PROVISIONER_BACKEND=fake
DOCKER_NETWORK_NAME=tiny-provisioner-apps
TRAEFIK_DYNAMIC_CONFIG_PATH=/var/lib/tiny-provisioner/traefik/apps.yml
SSH_HOST=
SSH_USER=provisioner
SSH_KEY_PATH=/run/secrets/tiny_provisioner_ssh_key
SSH_PORT=22
SSH_REMOTE_COMMAND=tiny-provisioner-remote
SSH_TIMEOUT_SECONDS=60
SSH_STRICT_HOST_KEY_CHECKING=true
MAX_ACTIVE_RESOURCES_PER_USER=3
DEFAULT_RESOURCE_TTL_HOURS=24
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=300
JOB_LEASE_SECONDS=90
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_STALE_AFTER_SECONDS=30
WORKER_METRICS_PORT=9101
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://provisioner:provisioner@postgres:5432/provisioner
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-real-deployments
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
